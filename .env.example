# Copy to .env (scripts/init_env.sh does it and generates random secrets). NEVER commit the real .env.
# Any value starting with "change-me" makes the server refuse to start (no default passwords).
DJANGO_SECRET_KEY=change-me-django-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200

# postgres (default) or sqlite (offline demo)
DB_ENGINE=postgres
POSTGRES_DB=tourism
POSTGRES_USER=tourism
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# SQLITE_PATH=backend/demo.sqlite3

# Docker only: load demo data on first start (1 = yes)
SEED_DEMO=1
# Password of every demo account (demo data only)
DEMO_PASSWORD=Demo#Tourism2026
